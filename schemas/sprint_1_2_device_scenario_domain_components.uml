@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam wrapWidth 300

 title
   <b>Задание 2. Проектирование микросервисной архитектуры</b>
   <i>Визуализация компонентов домена управления пользовательскими сценариями</i>
 end title

    Container(device_scenario_domain, "Управление пользовательскими сценариями") {
        Component(scenarioEngine, "Движок сценариев")
        Component(userScenarioRegistry, "Реестр пользовательских сценариев")
        Component(triggerRegistry, "Реестр триггеров подключенных устройств")
        Component(deviceDispatcher, "Отправка команд подключенным устройствам")
    }

System_Ext(device, "Подключенное устройство")

Rel(scenarioEngine, device, "Движок пользовательских сценариев")
Rel(userScenarioRegistry, device, "Управление пользовательскими сценариями")
Rel(triggerRegistry, device, "Обработка команд от подключенных устройств")
Rel(deviceDispatcher, device, "Отправка команд устройствам по сценарию пользователя")
@enduml